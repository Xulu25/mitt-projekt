Book::Book(string author, string title, int year)
{
	this->author = author;
	this->title = title;

	if (year <= 2025) {
		this->year = year;
	}
	else {
		this->year = 0;
	}
}

bool Book::operator==(const Book& other)
{
	return this->author == other.author && this->title == other.title &&
		this->year == other.year;
}

void Book::setYear(int year)
{
	if (year <= 2025) {
		this->year = year;
	}
}

BookStore::BookStore()
{
	this->name = "";
	this->currentNrOfBooks = 0;
}

BookStore::BookStore(string name)
{
	this->name = name;
	this->currentNrOfBooks = 0;
}

BookStore::~BookStore()
{
	for (int i = 0; i < currentNrOfBooks; i++) {
		delete ptrBook[i];
		ptrBook[i] = nullptr;
	}
}

-----ENKEL VERSION-----
bool BookStore::addBook(string author, string title, int year)
{
	if (getCurrentNrOfBooks() >= CAP) {
		return false;
	}
	Book* temp = new Book(author, title, year);
	ptrBook[currentNrOfBooks] = temp;
	currentNrOfBooks++;
	return true;
}

bool BookStore::removeBook(string author, string title, int year)
{
	for (int i = 0; i < currentNrOfBooks; i++) {

		if (ptrBook[i]->getAuthor() == author &&
			ptrBook[i]->getTitle() == title &&
			ptrBook[i]->getYear() == year) {

			delete ptrBook[i];
			ptrBook[i] = ptrBook[currentNrOfBooks - 1];
			ptrBook[currentNrOfBooks - 1] = nullptr;
			currentNrOfBooks--;
			return true;
		}
	}
	return false;
}

int BookStore::nrOfBooksByAuthorAndTitle(string author, string title)
{
	int counter = 0;
	for (int i = 0; i < currentNrOfBooks; i++) {
		
		if (ptrBook[i]->getAuthor() == author &&
			ptrBook[i]->getTitle() == title) {
			counter++;
		}
	}
	return counter;
}

