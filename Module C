#include "Car.h"

Car::Car()
{
    this->numDoors = 0;
    this->hasAirConditioning = 0;
}

Car::Car(string manufacturer, string model, string registrationNumber, int manufacturingYear, int numDoors, bool hasAirConditioning)
{
    this->setManufacturer(manufacturer);
    this->setModel(model);
    this->setRegistrationNumber(registrationNumber);
    this->setManufacturingYear(manufacturingYear);
    this->numDoors = numDoors;
    this->hasAirConditioning = hasAirConditioning;
}

Car::~Car()
{
}

int Car::setNumDoors(int numDoors)
{
    return this->numDoors = numDoors;
}

bool Car::setHasAirConditioning(bool hasAirConditioning)
{
    return this->hasAirConditioning = hasAirConditioning;
}

int Car::getNumDoors() const
{
    return this->numDoors;
}

bool Car::getHasAirConditioning() const
{
    return this->hasAirConditioning;
}

string Car::getDescription()
{
    return getManufacturer() + getModel() + getRegistrationNumber() +
        to_string(getManufacturingYear()) + to_string(getNumDoors()) + to_string(getHasAirConditioning());
}

unique_ptr<Vehicle> Car::clone()
{
    return make_unique<Car>(*this);
}

