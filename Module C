/// Dealership
#include "Dealership.h"

Dealership::Dealership(string name)
{
    this->name = name;
}

string Dealership::setName(string name)
{
    return this->name = name;
}

string Dealership::getName() const
{
    return this->name;
}

int Dealership::getNrOfVehicles() const
{
    return this->ptrVehicle.size();
}

Dealership::Dealership(const Dealership& other)
{
    this->name = other.name;

    for (int i = 0; i < other.ptrVehicle.size(); i++) {

        this->ptrVehicle.push_back(other.ptrVehicle[i]->clone());
    }
}

void Dealership::operator=(const Dealership& other)
{
    this->name = other.name;
    this->ptrVehicle.clear();

    for (size_t i = 0; i < other.ptrVehicle.size(); i++)
    {
        this->ptrVehicle.push_back(other.ptrVehicle[i]->clone());
    }
}

bool Dealership::addCar(string manufacturer, string model, string registrationNumber, int manufacturingYear, int numDoors, bool hasAirConditioning)
{
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (ptrVehicle[i]->getRegistrationNumber() == registrationNumber) {
            return false;
        }
    }
    unique_ptr<Car> tempCar = make_unique<Car>(manufacturer, model, registrationNumber, manufacturingYear, numDoors, hasAirConditioning);
    ptrVehicle.push_back(move(tempCar));
    return true;
}

bool Dealership::addMotorcycle(string manufacturer, string model, string registrationNumber, int manufacturingYear, int numWheels, int cubicCentimeters)
{
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (ptrVehicle[i]->getRegistrationNumber() == registrationNumber) {
            return false;
        }
    }
    unique_ptr<Motorcycle> tempMotorcycle = make_unique<Motorcycle>(manufacturer, model, registrationNumber, manufacturingYear, numWheels, cubicCentimeters);
    ptrVehicle.push_back(move(tempMotorcycle));
    return true;
}

string Dealership::getAllCarDescriptions()
{
    string final = "";
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (Car* tempCar = dynamic_cast<Car*>(ptrVehicle[i].get())) {
            
            final += tempCar->getDescription();
        }
    }
    return final;
}

string Dealership::getAllMotorcycleDescriptions()
{
    string final = "";
    
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (Motorcycle* tempMotorcycle = dynamic_cast<Motorcycle*>(ptrVehicle[i].get())) {

            final += tempMotorcycle->getDescription();
        }
    }
    return final;
}

string Dealership::getAllDescriptions()
{
    string final = "";

    for (int i = 0; i < ptrVehicle.size(); i++) {

        final += ptrVehicle[i]->getDescription();
    }
    return final;
}

int Dealership::getNumberOfCarsWithAirConditioning()
{
    int counter = 0;
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (Car* car = dynamic_cast<Car*>(ptrVehicle[i].get())) {

            if (car->getHasAirConditioning()) {
                counter++;
            }
         
        }
    }
    return counter;
}

int Dealership::getNumberOfMotorcyclesWithCubicCentimetersLargerThan(int cubicCentimeters)
{
    int counter = 0;

    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (Motorcycle * motorcycle = dynamic_cast<Motorcycle*>(ptrVehicle[i].get())) {

            if (motorcycle->getCubicCentimeters() > cubicCentimeters) {
                counter++;
            }
        }
    }
    return counter;
}

Vehicle* Dealership::getVehicleAt(int index)
{
    if (index >= ptrVehicle.size()) {
        return nullptr;
    }
    return ptrVehicle[index].get();
}

void Dealership::removeAllVehiclesOfManufacturerAndYear(string manufacturer, int manufacturingYear)
{
    for (int i = ptrVehicle.size() - 1; i >= 0; i--) {

        if (ptrVehicle[i]->getManufacturer() == manufacturer &&
            ptrVehicle[i]->getManufacturingYear() == manufacturingYear) {

            ptrVehicle.erase(ptrVehicle.begin() + i);
        }
    }
}

bool Dealership::removeVehicle(string registrationNumber)
{
    for (int i = 0; i < ptrVehicle.size(); i++) {

        if (ptrVehicle[i]->getRegistrationNumber() == registrationNumber) {

            ptrVehicle[i] = move(ptrVehicle[ptrVehicle.size() - 1]);
            ptrVehicle.pop_back();
            return true;
        }
    }
    return false;
}
