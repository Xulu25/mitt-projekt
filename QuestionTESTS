bool runSingleTests(const std::string& argument)
{
	if (argument == "initSimple")
		return TestingSimpleQuestionInitial();
	if (argument == "simpleValues")
		return TestingSimpleQuestionValues();
	if (argument == "initTrueFalse")
		return TestingTrueFalseQuestionInitial();
	if (argument == "trueFalseValues")
		return TestingTrueFalseQuestionValues();
	if (argument == "simpleInheritance")
		return TestingSimpleQuestionInheritance();
	if (argument == "trueFalseInheritance")
		return TestingTrueFalseQuestionInheritance();
	return false;
}

int main(int argc, char const* argv[])
{
	// Kod häremellan är för codegrade, kommer ej att köras på er lokala dator
#if defined(_WIN32) || defined(_WIN64)
	_CrtSetDbgFlag(_CRTDBG_ALLOC_MEM_DF | _CRTDBG_LEAK_CHECK_DF);
#endif
	if (argc > 1)
	{
		std::string argument(argv[1]);
		if (runSingleTests(argument))
			return 0;
		return 1;
	}
	// slut på codegrade kod
	if (!TestingSimpleQuestionInitial())
	{
		std::cout << "Not OK: TestingSimpleQuestionInitial()" << std::endl;
		return 1;
	}
	if (!TestingSimpleQuestionValues())
	{
		std::cout << "Not OK: TestingSimpleQuestionValues()" << std::endl;
		return 2;
	}
	if (!TestingTrueFalseQuestionInitial())
	{
		std::cout << "Not OK: TestingTrueFalseQuestionInitial()" << std::endl;
		return 3;
	}
	if (!TestingTrueFalseQuestionValues())
	{
		std::cout << "Not OK: TestingTrueFalseQuestionValues()" << std::endl;
		return 4;
	}
	if (!TestingSimpleQuestionInheritance())
	{
		std::cout << "Not OK: TestingSimpleQuestionInheritance()" << std::endl;
		return 5;
	}
	if (!TestingTrueFalseQuestionInheritance())
	{
		std::cout << "Not OK: TestingTrueFalseQuestionInheritance()" << std::endl;
		return 6;
	}
	std::cout << std::endl << "Remember to check for memory leaks in the output!" << std::endl;
	return 0;
}
