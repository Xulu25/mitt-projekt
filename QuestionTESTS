bool TestingSimpleQuestionValues()
{
	std::cout << std::endl << "Starting TestingSimpleQuestionValues()" << std::endl;
	std::cout << "  Testing default constructor, overloaded constructor, setters, and getters" << std::endl;

	SimpleQuestion aSimpleQuestion;

	const string expectedQuestion = "Huvudstaden i Norge?";
	string expectedAnswer = "Oslo";
	string expectedGivenAnswer = "Oslo";

	aSimpleQuestion.setQuestion(expectedQuestion);
	aSimpleQuestion.setCorrectAnswer(expectedAnswer);
	aSimpleQuestion.setGivenAnswer(expectedGivenAnswer);

	string what, expected;

	what = "question";
	expected = expectedQuestion;
	if (aSimpleQuestion.getQuestion() != expected)
	{
		std::cout << "NOT CORRECT 1: testing set/get " << what << ", expected " << expected \
			<< ", but got " << aSimpleQuestion.getQuestion() << std::endl;
		return false;
	}
	what = "correctAnswer";
	expected = expectedAnswer;
	if (aSimpleQuestion.getCorrectAnswer() != expected)
	{
		std::cout << "NOT CORRECT 2: testing set/get " << what << ", expected " << expected \
			<< ", but got " << aSimpleQuestion.getCorrectAnswer() << std::endl;
		return false;
	}
	what = "givenAnswer";
	expected = expectedGivenAnswer;
	if (aSimpleQuestion.getGivenAnswer() != expected)
	{
		std::cout << "NOT CORRECT 3: testing set/get " << what << ", expected " << expected \
			<< ", but got " << aSimpleQuestion.getGivenAnswer() << std::endl;
		return false;
	}

	// Testing overloaded constructor
	SimpleQuestion secondSimpleQuestion(expectedQuestion, expectedAnswer);
	secondSimpleQuestion.setGivenAnswer(expectedGivenAnswer);

	what = "question";
	expected = expectedQuestion;
	if (secondSimpleQuestion.getQuestion() != expected)
	{
		std::cout << "NOT CORRECT 4: testing overloaded constructor, get " << what << ", expected " << expected \
			<< ", but got " << secondSimpleQuestion.getQuestion() << std::endl;
		return false;
	}
	what = "correctAnswer";
	expected = expectedAnswer;
	if (secondSimpleQuestion.getCorrectAnswer() != expected)
	{
		std::cout << "NOT CORRECT 5: testing overloaded constructor, get " << what << ", expected " << expected \
			<< ", but got " << secondSimpleQuestion.getCorrectAnswer() << std::endl;
		return false;
	}
	what = "givenAnswer";
	expected = expectedGivenAnswer;
	if (secondSimpleQuestion.getGivenAnswer() != expected)
	{
		std::cout << "NOT CORRECT 6: testing overloaded constructor, get " << what << ", expected " << expected \
			<< ", but got " << secondSimpleQuestion.getGivenAnswer() << std::endl;
		return false;
	}

	std::cout << "OK: TestingSimpleQuestionValues()" << std::endl;
	return true;
}

