bool TestingSimpleQuestionInheritance()
{
	std::cout << std::endl << "Starting TestingSimpleQuestionInheritance()" << std::endl;
	std::cout << "  Testing using base class pointers and various functionality." << std::endl;

	Question* aQuestion = new SimpleQuestion("SimpleQuestion", "SimpleQuestion answer");

	string what = "isAnswered";
	if (aQuestion->isAnswered() != false)
	{
		std::cout << "NOT CORRECT 1: testing " << what << ", expected false, but got true" << std::endl;
		return false;
	}
	what = "isCorrect";
	if (aQuestion->isCorrect() != false)
	{
		std::cout << "NOT CORRECT 2: testing " << what << ", expected false, but got true" << std::endl;
		return false;
	}
	what = "getGivenAnswer";
	string expected = "";
	if (aQuestion->getGivenAnswer() != expected)
	{
		std::cout << "NOT CORRECT 3: testing " << what << ", expected " << expected
			<< ", but got " << aQuestion->getGivenAnswer() << std::endl;
		return false;
	}

	// Set correct answer
	SimpleQuestion* theSimpleQuestion = dynamic_cast<SimpleQuestion*>(aQuestion);
	theSimpleQuestion->setGivenAnswer(theSimpleQuestion->getCorrectAnswer());

	what = "isAnswered";
	if (aQuestion->isAnswered() != true)
	{
		std::cout << "NOT CORRECT 4: testing " << what << ", expected true, but got false" << std::endl;
		return false;
	}
	what = "isCorrect";
	if (aQuestion->isCorrect() != true)
	{
		std::cout << "NOT CORRECT 5: testing " << what << ", expected true, but got false" << std::endl;
		return false;
	}
	what = "getGivenAnswer";
	expected = aQuestion->getCorrectAnswer();
	if (aQuestion->getGivenAnswer() != expected)
	{
		std::cout << "NOT CORRECT 6: testing " << what << ", expected " << expected
			<< ", but got " << aQuestion->getGivenAnswer() << std::endl;
		return false;
	}

	// Set wrong answer
	string wrongAnswer = theSimpleQuestion->getCorrectAnswer() + "----";
	theSimpleQuestion->setGivenAnswer(wrongAnswer);

	what = "isAnswered";
	if (aQuestion->isAnswered() != true)
	{
		std::cout << "NOT CORRECT 7: testing " << what << ", expected true, but got false" << std::endl;
		return false;
	}
	what = "isCorrect";
	if (aQuestion->isCorrect() != false)
	{
		std::cout << "NOT CORRECT 8: testing " << what << ", expected false, but got true" << std::endl;
		return false;
	}
	what = "getGivenAnswer";
	expected = wrongAnswer;
	if (aQuestion->getGivenAnswer() != expected)
	{
		std::cout << "NOT CORRECT 9: testing " << what << ", expected " << expected
			<< ", but got " << aQuestion->getGivenAnswer() << std::endl;
		return false;
	}

	std::cout << "OK: TestingSimpleQuestionInheritance()" << std::endl;
	delete aQuestion;
	return true;
}

