bool TestRemoveQuestion()
{
	std::cout << std::endl << "Starting TestRemoveQuestion()" << std::endl;
	std::cout << "  Using addSimpleQuestion, addTrueFalseQuestion, getNrOfQuestions, getQuestionAt and removeQuestion." << std::endl;

	Quiz aQuiz;
	AddQuestions(aQuiz, 6);

	vector<Question*> questionsBeforeRemove;
	for (int i = 0; i < aQuiz.getNrOfQuestions(); i++) {
		questionsBeforeRemove.push_back(aQuiz.getQuestionAt(i));
	}

	bool removed = aQuiz.removeQuestion(2);
	questionsBeforeRemove.erase(questionsBeforeRemove.begin() + 2);

	if (removed != true)
	{
		std::cout << "NOT CORRECT 1: expected removeQuestion to return true when removing existing question, but returned false" << std::endl;
		return false;
	}
	if (aQuiz.getNrOfQuestions() != 5)
	{
		std::cout << "NOT CORRECT 2: expected number of questions to be 5 after removing question nr 2, but is " << aQuiz.getNrOfQuestions() << std::endl;
		return false;
	}

	for (int i = 0; i < aQuiz.getNrOfQuestions(); i++) {
		if (aQuiz.getQuestionAt(i) != questionsBeforeRemove[i]) {
			std::cout << "NOT CORRECT 3: expected remaining questions to be in same order after remove, but was not. Question " << i
				<< " differs." << std::endl;
			cout << "---Expected order after remove:---" << endl;
			for (Question* q : questionsBeforeRemove) {
				cout << q->getQuestion() << endl;
			}
			cout << "\n---Actual order after remove:---" << endl;
			for (int i = 0; i < aQuiz.getNrOfQuestions(); i++) {
				cout << aQuiz.getQuestionAt(i)->getQuestion() << endl;
			}
			return false;

		}
	}

	removed = aQuiz.removeQuestion(100);
	if (removed == true)
	{
		std::cout << "NOT CORRECT 4: expected removeQuestion to return false when trying to remove non-existing question, but returned true" << std::endl;
		return false;
	}

	std::cout << "OK: TestRemoveQuestion()" << std::endl;
	return true;
}

bool TestListQuestionsFunctions()
{
	std::cout << std::endl << "Starting TestListQuestionsFunctions()" << std::endl;
	std::cout << "  Using addSimpleQuestion, addTrueFalseQuestion, getNrOfQuestions, getQuestionAt, listQuestions, listQuestionsAndCorrectAnswers, listSimpleQuestions." << std::endl;

	Quiz aQuiz;
	aQuiz.addSimpleQuestion("Question1", "Answer1");
	aQuiz.addTrueFalseQuestion("Question2", true);
	aQuiz.addSimpleQuestion("Question3", "Answer3");
	aQuiz.addTrueFalseQuestion("Question4", false);


	std::vector<std::string> trueQuestions;
	trueQuestions.push_back(aQuiz.getQuestionAt(0)->getQuestion());
	trueQuestions.push_back(aQuiz.getQuestionAt(1)->getQuestion());
	trueQuestions.push_back(aQuiz.getQuestionAt(2)->getQuestion());
	trueQuestions.push_back(aQuiz.getQuestionAt(3)->getQuestion());

	std::vector<std::string> trueAnswers;
	trueAnswers.push_back(aQuiz.getQuestionAt(0)->getCorrectAnswer());
	trueAnswers.push_back(aQuiz.getQuestionAt(1)->getCorrectAnswer());
	trueAnswers.push_back(aQuiz.getQuestionAt(2)->getCorrectAnswer());
	trueAnswers.push_back(aQuiz.getQuestionAt(3)->getCorrectAnswer());

	std::string questions = aQuiz.listQuestions();
	for (auto trueQuestion : trueQuestions)
	{
		if (questions.find(trueQuestion) == std::string::npos)
		{
			std::cout << "NOT CORRECT 1: listQuestions() did not include all question descriptions" << std::endl;
			std::cout << "Got following questions" << std::endl << questions << std::endl;
			std::cout << "Wanted to find following description" << std::endl << trueQuestion << std::endl;
			return false;
		}
	}

	std::string questionsAndAnswers = aQuiz.listQuestionsAndCorrectAnswers();
	for (auto trueQuestion : trueQuestions)
	{
		if (questionsAndAnswers.find(trueQuestion) == std::string::npos)
		{
			std::cout << "NOT CORRECT 2: listQuestions() did not include all question descriptions" << std::endl;
			std::cout << "Got following questionsAndAnswers" << std::endl << questionsAndAnswers << std::endl;
			std::cout << "Wanted to find following questiondescription" << std::endl << trueQuestion << std::endl;
			return false;
		}
	}
	for (auto trueAnswer : trueAnswers)
	{
		if (questionsAndAnswers.find(trueAnswer) == std::string::npos)
		{
			std::cout << "NOT CORRECT 3: listQuestionsAndCorrectAnswers() did not include all answer descriptions" << std::endl;
			std::cout << "Got following questionsAndAnswers" << std::endl << questionsAndAnswers << std::endl;
			std::cout << "Wanted to find following answer description" << std::endl << trueAnswer << std::endl;
			return false;
		}
	}

	std::cout << "OK: TestListQuestionsFunctions()" << std::endl;
	return true;
}

