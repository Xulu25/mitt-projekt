void AddQuestions(Quiz& aQuiz, int nrOf = 12) // even nrOf
{
	for (int i = 0; i < nrOf / 2; ++i)
	{
		aQuiz.addSimpleQuestion("SimpleQuestion" + to_string(i), "Answer");
		aQuiz.addTrueFalseQuestion("TrueFalseQuestion" + to_string(i), true);
	}
}

